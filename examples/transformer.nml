// transformer.nml — Declarative Transformer Block
//
// This is a TensorLoom NML (Neural Markup Language) file.
// It defines a model architecture using @model, @config,
// @layers, and @forward decorator blocks.
//
// The @config values become overridable __init__ keyword
// arguments in the generated PyTorch class.

@model TransformerBlock:
    @config:
        d_model = 512
        n_heads = 8
        dropout_rate = 0.1

    @layers:
        attention = MultiHeadAttention(d_model, n_heads)
        norm1 = LayerNorm(d_model)
        norm2 = LayerNorm(d_model)
        ff = Linear(d_model, d_model)
        dropout = Dropout(dropout_rate)

    @forward(x):
        let residual = x
        x = norm1(x)
        x = residual + dropout(attention(x))
        let residual2 = x
        x = norm2(x)
        x = residual2 + dropout(ff(x))
        return x
